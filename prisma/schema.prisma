generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

model Analytics {
  mits_uid String
  role_id  Int
  pending  Int?    @default(0)
  approved Int?    @default(0)
  rejected Int?    @default(0)
  Faculty  Faculty @relation(fields: [mits_uid], references: [mits_uid])
  Roles    Roles   @relation(fields: [role_id], references: [role_id])

  @@id([mits_uid, role_id])
}

model Batches {
  batch_id   Int       @id @default(autoincrement())
  batch      String
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  Classes    Classes[]
  Student    Student[]

  @@index([is_active])
}

model Classes {
  class_id     Int            @id @default(autoincrement())
  batch_id     Int
  class        String
  dept_id      Int
  is_active    Boolean        @default(true)
  deleted_at   DateTime?
  ClassFaculty ClassFaculty[]
  Batches      Batches        @relation(fields: [batch_id], references: [batch_id])
  Departments  Departments    @relation(fields: [dept_id], references: [dept_id])
  Student      Student[]

  @@index([is_active])
  @@index([batch_id])
}

model ClassFaculty {
  class_id   Int
  mits_uid   String
  role_tag   String
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  Classes    Classes   @relation(fields: [class_id], references: [class_id])
  Faculty    Faculty   @relation(fields: [mits_uid], references: [mits_uid])
  Roles      Roles     @relation(fields: [role_tag], references: [role_tag])

  @@id([class_id, mits_uid, role_tag])
  @@index([is_active])
}

model ClubAdmin {
  club_admin_id Int       @id
  club_id       Int
  role_tag      String
  is_active     Boolean   @default(true)
  deleted_at    DateTime?
  Clubs         Clubs     @relation(fields: [club_id], references: [club_id])
  Roles         Roles     @relation(fields: [role_tag], references: [role_tag])

  @@index([is_active])
}

model Clubs {
  club_id              Int          @id
  club_name            String
  dept_id              Int?
  coordinator_role_tag String?
  is_active            Boolean      @default(true)
  deleted_at           DateTime?
  ClubAdmin            ClubAdmin[]
  Roles                Roles?       @relation(fields: [coordinator_role_tag], references: [role_tag])
  Departments          Departments? @relation(fields: [dept_id], references: [dept_id])

  @@index([is_active])
}

model Departments {
  dept_id           Int                 @id @default(autoincrement())
  dept_name         String
  is_active         Boolean             @default(true)
  deleted_at        DateTime?
  Classes           Classes[]
  Clubs             Clubs[]
  DepartmentFaculty DepartmentFaculty[]
  Faculty           Faculty[]

  @@index([is_active])
}

model Faculty {
  mits_uid          String             @id
  name              String
  department_id     Int
  email             String?            @unique
  is_active         Boolean            @default(true)
  deleted_at        DateTime?
  Analytics         Analytics[]
  ClassFaculty      ClassFaculty[]
  DepartmentFaculty DepartmentFaculty?
  Departments       Departments        @relation(fields: [department_id], references: [dept_id])
  UserAccount       UserAccount        @relation(fields: [mits_uid], references: [mits_uid])

  @@index([is_active])
  @@index([department_id])
}

model Procedures {
  proc_id             String                @id
  title               String
  desc_first_50_char  String?
  is_active           Boolean               @default(true)
  deleted_at          DateTime?
  created_by          String?
  ProcedureVisibility ProcedureVisibility[]
  Requests            Requests[]

  @@index([is_active])
}

model ProcedureVisibility {
  proc_id    String
  user_type  Int
  Procedures Procedures @relation(fields: [proc_id], references: [proc_id])

  @@id([proc_id, user_type])
}

model Requests {
  req_id      String      @id
  proc_id     String
  created_by  String
  created_at  DateTime    @default(now())
  status      Int
  UserAccount UserAccount @relation(fields: [created_by], references: [mits_uid])
  Procedures  Procedures  @relation(fields: [proc_id], references: [proc_id])
  ToApprove   ToApprove[]

  @@index([created_by])
  @@index([proc_id])
}

model RoleMapping {
  role_mapping_id Int         @id
  role_id         Int
  mits_uid        String
  is_active       Boolean     @default(true)
  deleted_at      DateTime?
  UserAccount     UserAccount @relation(fields: [mits_uid], references: [mits_uid])
  Roles           Roles       @relation(fields: [role_id], references: [role_id])

  @@index([is_active])
  @@index([mits_uid])
}

model Roles {
  role_id           Int                 @id @default(autoincrement())
  role_tag          String              @unique
  role_desc         String?
  is_active         Boolean             @default(true)
  deleted_at        DateTime?
  Analytics         Analytics[]
  ClassFaculty      ClassFaculty[]
  ClubAdmin         ClubAdmin[]
  Clubs             Clubs[]
  DepartmentFaculty DepartmentFaculty[]
  RoleMapping       RoleMapping[]

  @@index([is_active])
}

model Student {
  mits_uid    String      @id
  name        String
  batch_id    Int
  class_id    Int
  hosteller   Boolean
  gender      String?
  phone       String?     @unique
  is_active   Boolean     @default(true)
  deleted_at  DateTime?
  Batches     Batches     @relation(fields: [batch_id], references: [batch_id])
  Classes     Classes     @relation(fields: [class_id], references: [class_id])
  UserAccount UserAccount @relation(fields: [mits_uid], references: [mits_uid])

  @@index([is_active])
  @@index([class_id])
}

model UserAccount {
  mits_uid    String        @id
  auth_uid    String        @unique
  user_type   Int
  is_active   Boolean       @default(true)
  deleted_at  DateTime?
  email       String?       @unique
  Faculty     Faculty?
  Requests    Requests[]
  RoleMapping RoleMapping[]
  Student     Student?
  ToApprove   ToApprove[]
  UserTypes   UserTypes     @relation(fields: [user_type], references: [user_type_id])

  @@index([is_active])
  @@index([user_type])
  @@index([auth_uid])
}

model UserTypes {
  user_type_id  Int           @id
  user_type_tag String        @unique
  description   String?
  is_active     Boolean       @default(true)
  UserAccount   UserAccount[]
}

model ToApprove {
  req_id        String
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  approverUID   String
  approvalLevel Int?
  approvalType  String?
  UserAccount   UserAccount @relation(fields: [approverUID], references: [mits_uid], onDelete: NoAction, onUpdate: NoAction)
  Requests      Requests    @relation(fields: [req_id], references: [req_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([req_id, approverUID])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model DepartmentFaculty {
  mits_uid    String      @id
  dept_id     Int
  role_id     Int?
  is_active   Boolean?
  deleted_at  DateTime?   @db.Timestamp(6)
  Departments Departments @relation(fields: [dept_id], references: [dept_id], onDelete: NoAction, onUpdate: NoAction)
  Faculty     Faculty     @relation(fields: [mits_uid], references: [mits_uid], onDelete: NoAction, onUpdate: NoAction)
  Roles       Roles?      @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
}
