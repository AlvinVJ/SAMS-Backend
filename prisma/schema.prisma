generator client {
  provider      = "prisma-client-js"
  output        = "../generated"
  binaryTargets = ["rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Analytics {
  mits_uid String
  role_id  Int
  pending  Int?    @default(0)
  approved Int?    @default(0)
  rejected Int?    @default(0)
  Faculty  Faculty @relation(fields: [mits_uid], references: [mits_uid])
  Roles    Roles   @relation(fields: [role_id], references: [role_id])

  @@id([mits_uid, role_id])
}

model Batches {
  batch_id   Int       @id @default(autoincrement())
  batch      String
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  Classes    Classes[]
  Student    Student[]

  @@index([is_active])
}

model ClassFaculty {
  class_id   Int
  mits_uid   String
  role_tag   String
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  Classes    Classes   @relation(fields: [class_id], references: [class_id])
  Faculty    Faculty   @relation(fields: [mits_uid], references: [mits_uid])
  Roles      Roles     @relation(fields: [role_tag], references: [role_tag])

  @@id([class_id, mits_uid, role_tag])
  @@index([is_active])
}

model Classes {
  class_id     Int            @id @default(autoincrement())
  batch_id     Int
  class        String
  dept_id      Int
  is_active    Boolean        @default(true)
  deleted_at   DateTime?
  ClassFaculty ClassFaculty[]
  Batches      Batches        @relation(fields: [batch_id], references: [batch_id])
  Departments  Departments    @relation(fields: [dept_id], references: [dept_id])
  Student      Student[]

  @@index([batch_id])
  @@index([is_active])
}

model ClubAdmin {
  club_admin_id   Int          @id
  club_id         Int
  is_active       Boolean      @default(true)
  deleted_at      DateTime?
  role_mapping_id Int?
  Clubs           Clubs        @relation(fields: [club_id], references: [club_id])
  RoleMapping     RoleMapping? @relation(fields: [role_mapping_id], references: [role_mapping_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active])
}

model Clubs {
  club_id                     Int          @id
  club_name                   String
  dept_id                     Int?
  is_active                   Boolean      @default(true)
  deleted_at                  DateTime?
  coordinator_role_mapping_id Int?
  ClubAdmin                   ClubAdmin[]
  RoleMapping                 RoleMapping? @relation(fields: [coordinator_role_mapping_id], references: [role_mapping_id], onDelete: NoAction, onUpdate: NoAction)
  Departments                 Departments? @relation(fields: [dept_id], references: [dept_id])

  @@index([is_active])
}

model DepartmentFaculty {
  mits_uid    String      @id
  dept_id     Int
  role_id     Int?
  is_active   Boolean?
  deleted_at  DateTime?   @db.Timestamp(6)
  Departments Departments @relation(fields: [dept_id], references: [dept_id], onDelete: NoAction, onUpdate: NoAction)
  Faculty     Faculty     @relation(fields: [mits_uid], references: [mits_uid], onDelete: NoAction, onUpdate: NoAction)
  Roles       Roles?      @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)
}

model Departments {
  dept_id           Int                 @id @default(autoincrement())
  dept_name         String
  is_active         Boolean             @default(true)
  deleted_at        DateTime?
  Classes           Classes[]
  Clubs             Clubs[]
  DepartmentFaculty DepartmentFaculty[]
  Faculty           Faculty[]

  @@index([is_active])
}

model FCMTokens {
  mits_uid   String
  session_id String
  fcm_token  String
  created_at DateTime @default(now())

  @@id([mits_uid, session_id])
  @@index([mits_uid])
}

model Faculty {
  mits_uid          String             @id
  name              String
  department_id     Int
  email             String?            @unique
  is_active         Boolean            @default(true)
  deleted_at        DateTime?
  Analytics         Analytics[]
  ClassFaculty      ClassFaculty[]
  DepartmentFaculty DepartmentFaculty?
  Departments       Departments        @relation(fields: [department_id], references: [dept_id])

  @@index([department_id])
  @@index([is_active])
}

model ProcedureVisibility {
  proc_id    String
  user_type  Int
  Procedures Procedures @relation(fields: [proc_id], references: [proc_id])

  @@id([proc_id, user_type])
}

model Procedures {
  proc_id             String                @id
  title               String
  desc_first_50_char  String?
  is_active           Boolean               @default(true)
  deleted_at          DateTime?
  created_by          String?
  ProcedureVisibility ProcedureVisibility[]
  Requests            Requests[]

  @@index([is_active])
}

model Requests {
  req_id     String      @id
  proc_id    String
  created_by String
  created_at DateTime    @default(now())
  status     Int
  Procedures Procedures  @relation(fields: [proc_id], references: [proc_id])
  ToApprove  ToApprove[]

  @@index([created_by])
  @@index([proc_id])
}

model RoleMapping {
  role_mapping_id Int         @id
  role_id         Int
  mits_uid        String
  is_active       Boolean     @default(true)
  deleted_at      DateTime?
  ClubAdmin       ClubAdmin[]
  Clubs           Clubs[]
  Roles           Roles       @relation(fields: [role_id], references: [role_id])

  @@index([is_active])
  @@index([mits_uid])
}

model Roles {
  role_id           Int                 @id @default(autoincrement())
  role_tag          String              @unique
  role_desc         String?
  is_active         Boolean             @default(true)
  deleted_at        DateTime?
  Analytics         Analytics[]
  ClassFaculty      ClassFaculty[]
  DepartmentFaculty DepartmentFaculty[]
  RoleMapping       RoleMapping[]

  @@index([is_active])
}

model Student {
  mits_uid   String    @id
  name       String
  batch_id   Int
  class_id   Int
  hosteller  Boolean
  gender     String?
  phone      String?   @unique
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  Batches    Batches   @relation(fields: [batch_id], references: [batch_id])
  Classes    Classes   @relation(fields: [class_id], references: [class_id])

  @@index([class_id])
  @@index([is_active])
}

model ToApprove {
  req_id        String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  approverUID   String
  approvalLevel Decimal? @db.Decimal
  approvalType  String?
  Requests      Requests @relation(fields: [req_id], references: [req_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([req_id, approverUID])
}

model UserAccount {
  mits_uid   String    @id
  auth_uid   String    @unique
  user_type  Int
  is_active  Boolean   @default(true)
  deleted_at DateTime?
  email      String?   @unique
  isBanned   Boolean   @default(false)
  UserTypes  UserTypes @relation(fields: [user_type], references: [user_type_id])

  @@index([auth_uid])
  @@index([is_active])
  @@index([user_type])
}

model UserTypes {
  user_type_id  Int           @id
  user_type_tag String        @unique
  description   String?
  is_active     Boolean       @default(true)
  UserAccount   UserAccount[]
}
