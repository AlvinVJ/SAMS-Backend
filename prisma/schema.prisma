generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}

model Batches {
  batch_id Int       @id(map: "PK__Batches__DBFC0431F789BB48")
  batch    String    @db.NVarChar(50)
  Classes  Classes[]
  Student  Student[]
}

model Classes {
  class_id     Int            @id(map: "PK__Classes__FDF47986627E2002")
  batch_id     Int
  class        String         @db.NVarChar(50)
  dept_id      String         @db.NVarChar(50)
  Batches      Batches        @relation(fields: [batch_id], references: [batch_id], onUpdate: NoAction, map: "FK_Classes_Batch")
  Departments  Departments    @relation(fields: [dept_id], references: [dept_id], onUpdate: NoAction, map: "FK_Classes_Department")
  ClassFaculty ClassFaculty[]
  Student      Student[]
}

model ClassFaculty {
  class_id Int
  mits_uid String  @db.NVarChar(50)
  role_tag String  @db.NVarChar(50)
  Classes  Classes @relation(fields: [class_id], references: [class_id], onUpdate: NoAction, map: "FK_ClassFaculty_Class")
  Faculty  Faculty @relation(fields: [mits_uid], references: [mits_uid], onUpdate: NoAction, map: "FK_ClassFaculty_Faculty")
  Roles    Roles   @relation(fields: [role_tag], references: [role_tag], onUpdate: NoAction, map: "FK_ClassFaculty_Role")

  @@id([class_id, mits_uid, role_tag], map: "PK_ClassFaculty")
}

model ClubAdmin {
  club_admin_id Int    @id(map: "PK__ClubAdmi__F81AA8C10CFC34E3")
  club_id       Int
  role_tag      String @db.NVarChar(50)
  Clubs         Clubs  @relation(fields: [club_id], references: [club_id], onUpdate: NoAction, map: "FK_ClubAdmin_Club")
  Roles         Roles  @relation(fields: [role_tag], references: [role_tag], onUpdate: NoAction, map: "FK_ClubAdmin_Role")
}

model Clubs {
  club_id              Int          @id(map: "PK__Clubs__BCAD3DD94E05A659")
  club_name            String       @db.NVarChar(100)
  dept_id              String?      @db.NVarChar(50)
  coordinator_role_tag String?      @db.NVarChar(50)
  ClubAdmin            ClubAdmin[]
  Roles                Roles?       @relation(fields: [coordinator_role_tag], references: [role_tag], onDelete: NoAction, onUpdate: NoAction, map: "FK_Clubs_CoordinatorRole")
  Departments          Departments? @relation(fields: [dept_id], references: [dept_id], onDelete: NoAction, onUpdate: NoAction, map: "FK_Clubs_Department")

  @@index([dept_id], map: "IDX_Clubs_Department")
}

model Departments {
  dept_id   String    @id(map: "PK__Departme__DCA659749AB1D5AE") @db.NVarChar(50)
  dept_name String    @db.NVarChar(100)
  Classes   Classes[]
  Clubs     Clubs[]
  Faculty   Faculty[]
}

model Faculty {
  mits_uid      String         @id(map: "PK__Faculty__DE14EEAD8476420B") @db.NVarChar(50)
  name          String         @db.NVarChar(100)
  department_id String         @db.NVarChar(50)
  email         String?        @unique(map: "UQ__Faculty__AB6E61646E3FA475") @db.NVarChar(100)
  is_active     Boolean        @default(true, map: "DF__Faculty__is_acti__0880433F")
  ClassFaculty  ClassFaculty[]
  Departments   Departments    @relation(fields: [department_id], references: [dept_id], onUpdate: NoAction, map: "FK_Faculty_Department")
  UserAccount   UserAccount    @relation(fields: [mits_uid], references: [mits_uid], onUpdate: NoAction, map: "FK_Faculty_User")

  @@index([department_id], map: "IDX_Faculty_Department")
}

model RoleMapping {
  role_mapping_id Int         @id(map: "PK__RoleMapp__95B82AEF10F28EF1")
  role_id         Int
  mits_uid        String      @db.NVarChar(50)
  is_active       Boolean     @default(true, map: "DF__RoleMappi__is_ac__10216507")
  Roles           Roles       @relation(fields: [role_id], references: [role_id], onUpdate: NoAction, map: "FK_RoleMapping_Role")
  UserAccount     UserAccount @relation(fields: [mits_uid], references: [mits_uid], onUpdate: NoAction, map: "FK_RoleMapping_User")

  @@index([role_id], map: "IDX_RoleMapping_Role")
  @@index([mits_uid], map: "IDX_RoleMapping_User")
}

model Roles {
  role_id      Int            @id(map: "PK__Roles__760965CCC4CEA53C")
  role_tag     String         @unique(map: "UQ__Roles__58B68BEF4E6CD547") @db.NVarChar(50)
  description  String?        @db.NVarChar(255)
  ClassFaculty ClassFaculty[]
  ClubAdmin    ClubAdmin[]
  Clubs        Clubs[]
  RoleMapping  RoleMapping[]
}

model Student {
  mits_uid    String      @id(map: "PK__Student__DE14EEAD0AFB5FCD") @db.NVarChar(50)
  name        String      @db.NVarChar(100)
  batch_id    Int
  class_id    Int
  hosteller   Boolean
  gender      String?     @db.Char(1)
  phone       String?     @unique(map: "UQ__Student__B43B145F0A174CD0") @db.NVarChar(20)
  is_active   Boolean     @default(true, map: "DF__Student__is_acti__01D345B0")
  Batches     Batches     @relation(fields: [batch_id], references: [batch_id], onUpdate: NoAction, map: "FK_Student_Batch")
  Classes     Classes     @relation(fields: [class_id], references: [class_id], onUpdate: NoAction, map: "FK_Student_Class")
  UserAccount UserAccount @relation(fields: [mits_uid], references: [mits_uid], onUpdate: NoAction, map: "FK_Student_User")

  @@index([class_id], map: "IDX_Student_Class")
}

model UserAccount {
  mits_uid    String        @id(map: "PK__UserAcco__DE14EEADCC84438B") @db.NVarChar(50)
  clerk_uid   String        @db.NVarChar(100)
  user_type   Int
  Faculty     Faculty?
  RoleMapping RoleMapping[]
  Student     Student?
}
